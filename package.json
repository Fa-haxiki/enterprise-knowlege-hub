{
  "name": "enterprise-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Knowledge Hub - Agentic RAG knowledge base",
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:api": "pnpm --filter @ekh/api dev",
    "dev:worker": "pnpm --filter @ekh/worker dev",
    "dev:web": "pnpm --filter @ekh/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migration:run": "pnpm --filter @ekh/api migration:run",
    "migration:generate": "pnpm --filter @ekh/api migration:generate",
    "seed:admin": "pnpm --filter @ekh/api seed:admin"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
