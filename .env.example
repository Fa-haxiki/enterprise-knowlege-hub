# ---- 基础 ----
NODE_ENV=development
API_PORT=8080
JWT_SECRET=change-me-32-bytes-random-string
CORS_ORIGIN=http://localhost:5173

# ---- 存储 ----
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me-pg
PG_DB=ekh
DATABASE_URL=postgresql://postgres:change-me-pg@localhost:5432/ekh

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379

ES_NODE=http://localhost:9200
ES_INDEX=kb_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=ekh
MINIO_PASSWORD=change-me-minio
MINIO_BUCKET=ekh-docs

# ---- AI 服务（OpenAI 兼容协议，可接 DeepSeek/通义/OpenAI/Ollama）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
LLM_ROUTER_MODEL=deepseek-chat

EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

RERANKER_URL=http://localhost:8002/rerank
RERANKER_MODEL=bge-reranker-v2-m3

TTS_BASE_URL=
TTS_API_KEY=
# 内置 TTS 微服务（edge-tts）
TTS_SERVICE_URL=http://localhost:8750

# ---- 内部服务 ----
MINERU_URL=http://localhost:8700
MEM0_URL=http://localhost:8888
MEM0_API_KEY=

# ---- 安全加固 ----
# 全局限流：次/分/IP（压测时临时调大）
THROTTLE_LIMIT=120
# Prompt 注入检测（false 关闭）
PROMPT_INJECTION_BLOCK=true
# LLM 出站内容脱敏：身份证/银行卡/手机号/邮箱（false 关闭）
LLM_MASK_SENSITIVE=true

LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ---- RAG 参数 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_K=20
RERANK_TOP_N=6
RERANK_MIN_SCORE=0.35
RRF_K=60
GRAPH_MAX_HOPS=3
ACL_CACHE_TTL_SECONDS=600
CHAT_RATE_LIMIT_PER_MIN=20

# ---- 管理员种子 ----
ADMIN_EMAIL=admin@ekh.local
ADMIN_PASSWORD=admin123456
ADMIN_NAME=系统管理员
